# URL pública del sitio (obligatoria en producción para callbacks QPayPro)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=50200000000

# Panel /admin
ADMIN_PASSWORD=ineedyou-admin
ADMIN_SESSION_SECRET=cambia-este-secreto

# Supabase (UN solo proyecto) — obligatorio en Vercel
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# IMPORTANTE: usa la key JWT legacy "anon" "public" (empieza con eyJ...)
# Settings → API Keys → Legacy anon. Sin esto, registro da "Invalid API key".
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Opcional (nueva); si solo pones sb_publishable_, el signup puede fallar
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret / service_role (solo servidor, NUNCA en el frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# QPayPro — sandbox usa credenciales de prueba por defecto si no defines estas
QPAYPRO_ENVIRONMENT=sandbox
QPAYPRO_X_LOGIN=visanetgt_qpay
QPAYPRO_X_API_KEY=88888888888

# true = página de simulación local en vez de hosted checkout
# false / omitir = redirige a QPayPro (sandbox o production)
QPAYPRO_DEMO_MODE=false

# Producción (cuando Shannon tenga afiliación)
# QPAYPRO_ENVIRONMENT=production
# QPAYPRO_X_LOGIN=tu_login_comercio
# QPAYPRO_X_API_KEY=tu_api_key
# QPAYPRO_X_PRIVATE_KEY=tu_private_key
# QPAYPRO_X_API_SECRET=tu_api_secret

# Correos de pedido (opcional). Sin esto, se loguean en consola.
ORDER_NOTIFY_EMAIL=pedidos@tudominio.com
SMTP_FROM="I NEED YOU <pedidos@tudominio.com>"
# Opción A — Resend
# RESEND_API_KEY=re_xxx
# Opción B — SMTP
# SMTP_HOST=smtp.tudominio.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
